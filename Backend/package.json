    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "node-fetch": "^3.3.2",
    "request-ip": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/node-fetch": "^2.6.13",
    "@types/request-ip": "^0.0.41",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "_moduleAliases": {
    "@shared": "dist/shared"
