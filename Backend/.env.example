FRONTEND_IP=localhost
FRONTEND_PORT=5000
BACKEND_PORT=5001
AUTOTIME_PORT=5002
TELEMETRY_UDP_PORT=20777
DIRT_RALLY_UDP_PORT=20778

# Where AutoTime sends lap times. Only needed if AutoTime runs on another computer than the Backend.
# BACKEND_URL=http://YOUR_BACKEND_IP:5001

NODE_ENV=development

ACCESS_TOKEN_SECRET=YOUR_ACCESS_TOKEN_SECRET
REFRESH_TOKEN_SECRET=YOUR_REFRESH_TOKEN_SECRET

# The SQLite database file, relative to the Backend folder
DATABASE_URL=file:./data/leaderboard.db

# Used by `npm run db:seed` to create the admin who can log in
ADMIN_USERNAME=YOUR_ADMIN_USERNAME
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
