# Settings for the devcontainer only. These values are for local development and must
# never be used in production. They take precedence over Backend/.env inside the container.

NODE_ENV=development

FRONTEND_IP=localhost
FRONTEND_PORT=4200
BACKEND_PORT=5001
AUTOTIME_PORT=5002
TELEMETRY_UDP_PORT=20777
DIRT_RALLY_UDP_PORT=20778

ACCESS_TOKEN_SECRET=dev-only-access-token-secret-do-not-use-in-production
REFRESH_TOKEN_SECRET=dev-only-refresh-token-secret-do-not-use-in-production

# A separate SQLite database for the devcontainer, in Backend/data
DATABASE_URL=file:./data/dev.db

# Used when the database is created: an admin who can log in
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
