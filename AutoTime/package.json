{
  "name": "leaderboard-autotime",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.ts",
    "build": "tsc -p .",
    "prod": "npm run build && cross-env NODE_ENV=production nodemon src/server.ts"
  },
  "nodemonConfig": {
    "ignore": [
      "src/cache/*"
    ]
  },
  "dependencies": {
    "@racehub-io/f1-telemetry-client": "^0.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "module-alias": "^2.3.4",
    "nodemon": "^3.1.14",
    "request-ip": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/request-ip": "^0.0.41",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
